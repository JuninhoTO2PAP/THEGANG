# Copie para .env e troque os segredos. Nunca commite o .env.
#   copy .env.example .env

ENVIRONMENT=development
SECRET_KEY=sua_chave_aqui_troque_em_producao_min_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256
BCRYPT_ROUNDS=12

# SQLite local. Em produção (PostgreSQL), instale o driver: pip install "psycopg[binary]"
# DATABASE_URL=postgresql+psycopg://thegang:senha@localhost:5432/thegang
DATABASE_URL=sqlite:///./thegang.db

# Origens do frontend, separadas por vírgula. Em produção, só HTTPS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Vazio = backend/uploads
UPLOADS_DIR=

# Web Push (se vazio, gera .vapid.json em desenvolvimento)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:admin@example.com

# LiveKit — calls de voz/vídeo/tela (obrigatório para /api/voice/token)
# URL = Project URL (wss://….livekit.cloud). SIP URI não é usada neste app.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
